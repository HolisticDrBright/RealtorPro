{
  "name": "vanessa-command-center",
  "version": "0.2.0",
  "private": true,
  "description": "Luxury real estate command center — CRM, tasks, buyers, listings, pipeline, escrows and income in one local-first app.",
  "scripts": {
    "dev": "tsx scripts/start.ts dev",
    "build": "next build",
    "start": "tsx scripts/start.ts start",
    "launch": "tsx scripts/start.ts start --open",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "node scripts/verify-browser.mjs",
    "test:investors-browser": "node scripts/verify-investors.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts",
    "db:clear": "tsx src/db/clear.ts",
    "setup:empty": "npm run db:migrate",
    "setup": "node scripts/check-stopped.mjs && node scripts/macos/build-helper.mjs && npm run db:migrate",
    "mcp": "tsx scripts/mcp-server.ts",
    "mcp:config": "tsx scripts/mcp-server.ts --config"
  },
  "overrides": {
    "next": { "postcss": "$postcss", "sharp": "0.35.4" },
    "@esbuild-kit/core-utils": { "esbuild": "^0.25.12" }
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-sqlite3": "^12.4.1",
    "drizzle-orm": "^0.45.2",
    "next": "^15.5.25",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.12",
    "@types/node": "^22.12.0",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "8.57.1",
    "eslint-config-next": "^15.5.25",
    "playwright": "^1.58.2",
    "postcss": "^8.5.28",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.13",
    "typescript": "5.7.3",
    "vitest": "^3.2.6"
  }
}
