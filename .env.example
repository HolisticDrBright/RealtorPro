# ─────────────────────────────────────────────────────────────────────────────
# AgentOS — environment configuration
#
# Copy this file to `.env` and fill in values for a local run.
# NEVER commit `.env` or any real API key / client data. `.env` is gitignored.
# AgentOS is local-first: with no keys set, it runs fully on the built-in MOCK
# providers so the whole workflow works without credentials.
# ─────────────────────────────────────────────────────────────────────────────

# --- Local storage ----------------------------------------------------------
# Root folder for the SQLite database, uploaded listing assets, and generated
# output. Kept OUTSIDE the Next.js `public/` directory so assets are never
# served as static files. Defaults to `./workspace` if unset.
AGENTOS_WORKSPACE_DIR=./workspace

# --- Provider selection -----------------------------------------------------
# Which adaptor to use for each capability. "mock" (default) requires no keys
# and drives the full workflow locally. Switching to a real provider requires
# the matching key below AND, per product policy, explicit in-app approval
# before any remote generation runs.
AGENTOS_LLM_PROVIDER=mock                 # mock | anthropic | openai-compatible
AGENTOS_MEDIA_PROVIDER=mock               # mock | higgsfield
AGENTOS_VIDEO_ASSEMBLY=ffmpeg-detect      # ffmpeg-detect | mock

# --- LLM drafting / structured extraction -----------------------------------
# Only read when AGENTOS_LLM_PROVIDER != mock. Leave blank for local dev.
AGENTOS_LLM_BASE_URL=
AGENTOS_LLM_API_KEY=
AGENTOS_LLM_MODEL=

# --- Claude ------------------------------------------------------------------
# Optional. With a key, "Ask Claude for today's game plan" writes the briefing
# from the dashboard's verified facts only. Set AGENTOS_LLM_PROVIDER=anthropic
# above to ALSO use Claude for Buyer Scout alert extraction and Listing Studio
# drafting (always fact-restricted, "[TBD — source required]" for gaps).
# Nothing is ever sent to clients; Claude only writes text for you to read.
ANTHROPIC_API_KEY=
AGENTOS_CLAUDE_MODEL=claude-opus-5

# --- Obsidian vault (memory) -------------------------------------------------
# Absolute path to your vault folder. Notes are read in place and indexed into
# the local database (title, tags, [[wikilinks]], frontmatter, excerpt) so they
# show on the matching contact's timeline. AgentOS writes ONLY into the folder
# named by OBSIDIAN_WRITE_FOLDER and never edits or deletes your notes.
#   macOS:   OBSIDIAN_VAULT_DIR=/Users/you/Documents/MyVault
#   Windows: OBSIDIAN_VAULT_DIR=C:\Users\you\Documents\MyVault
OBSIDIAN_VAULT_DIR=
OBSIDIAN_WRITE_FOLDER=AgentOS
# Optional comma-separated vault-relative folders to limit / skip indexing.
OBSIDIAN_INCLUDE_FOLDERS=
OBSIDIAN_EXCLUDE_FOLDERS=
# Let Claude read short excerpts of recent vault notes when writing the
# briefing. Off by default — the vault is never sent anywhere unless you opt in.
OBSIDIAN_ALLOW_CLAUDE=false

# --- Work calendar ----------------------------------------------------------
# Events are local; Gmail / Outlook exports can be imported as .ics files with
# no account connection. Live OAuth sync is a separate connector you approve.

# --- Higgsfield-compatible image / video generation -------------------------
# Only read when AGENTOS_MEDIA_PROVIDER=higgsfield.
HIGGSFIELD_BASE_URL=
HIGGSFIELD_API_KEY=

# --- ffmpeg (local video assembly) ------------------------------------------
# Path to the ffmpeg binary. If unset AgentOS looks it up on PATH; if not found
# the assembly step degrades to a mock manifest so the workflow still completes.
FFMPEG_PATH=

# --- Follow Up Boss ---------------------------------------------------------
# User-provided FUB API key. Stored locally only. AgentOS uses READ + draft/task
# write scope only: it never sends messages/emails or creates leads on its own.
# Leave blank to use the built-in mock FUB adapter.
FUB_API_KEY=
FUB_BASE_URL=https://api.followupboss.com/v1
# Shared secret used to verify inbound FUB webhook signatures. Real-time
# webhooks require a secure hosted relay (see docs/ARCHITECTURE.md) — the local
# receiver is for development and documentation only.
FUB_WEBHOOK_SECRET=

# --- Generation cost / rate limits ------------------------------------------
# Guardrails on the generation job queue. Cost is a preflight ESTIMATE in USD.
AGENTOS_MAX_JOBS_PER_HOUR=20
AGENTOS_MAX_JOB_COST_USD=25
AGENTOS_DAILY_SPEND_CAP_USD=100

# --- Google Calendar + Gmail (read-only, for the daily briefing) ------------
# Optional. Create an OAuth client in Google Cloud Console (APIs & Services →
# Credentials → OAuth client ID, type "Web application") with the redirect URI
# below, enable the Google Calendar API and Gmail API, then paste the id/secret.
# AgentOS asks only for calendar.readonly + gmail.readonly: it can read your
# calendar and inbox subjects/snippets, and can never send mail or edit events.
# Tokens are stored in workspace/google-tokens.json on this machine only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
