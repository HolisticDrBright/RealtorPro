# Vanessa Real Estate — Command Center
# Copy to `.env`. Everything runs locally; no keys are required.

# Folder for the SQLite database (gitignored). Defaults to ./workspace
WORKSPACE_DIR=./workspace

# Future integrations plug in here (see README → Integration points):
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MLS_API_KEY=
# TWILIO_ACCOUNT_SID=

# --- Claude (optional) --------------------------------------------------------
# With a key: "Ask Claude" writes the morning briefing from the dashboard facts,
# and Integrations → "Import with Claude" turns pasted text (emails, meeting
# notes, spreadsheets) into contacts, buyers, listings, escrows and tasks that
# you review before they are saved. Claude never contacts anyone.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5

# --- Obsidian vault (optional) ------------------------------------------------
# Absolute path to your vault. Notes are read in place (never edited) and
# indexed; notes that name a contact or address show on that record. Notes with
# frontmatter `type: contact|buyer|seller|property|listing|transaction|task`
# can be imported as real records from Integrations → "Import from vault".
#   Windows: OBSIDIAN_VAULT_DIR=C:\Users\Brand\Documents\MyVault
#   macOS:   OBSIDIAN_VAULT_DIR=/Users/you/Documents/MyVault
OBSIDIAN_VAULT_DIR=
OBSIDIAN_WRITE_FOLDER=Command Center
OBSIDIAN_INCLUDE_FOLDERS=
OBSIDIAN_EXCLUDE_FOLDERS=
# Let Claude read your notes and propose records (Integrations → "Let Claude
# read the vault"). Off by default because note text is sent to the Anthropic
# API. You still review everything before it is saved.
OBSIDIAN_ALLOW_CLAUDE=false
