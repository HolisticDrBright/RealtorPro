# ─────────────────────────────────────────────────────────────────────────────
# AgentOS — environment configuration
#
# Copy this file to `.env` and fill in values for a local run.
# NEVER commit `.env` or any real API key / client data. `.env` is gitignored.
# AgentOS is local-first: with no keys set, it runs fully on the built-in MOCK
# providers so the whole workflow works without credentials.
# ─────────────────────────────────────────────────────────────────────────────

# --- Local storage ----------------------------------------------------------
# Root folder for the SQLite database, uploaded listing assets, and generated
# output. Kept OUTSIDE the Next.js `public/` directory so assets are never
# served as static files. Defaults to `./workspace` if unset.
AGENTOS_WORKSPACE_DIR=./workspace

# --- Provider selection -----------------------------------------------------
# Which adaptor to use for each capability. "mock" (default) requires no keys
# and drives the full workflow locally. Switching to a real provider requires
# the matching key below AND, per product policy, explicit in-app approval
# before any remote generation runs.
AGENTOS_LLM_PROVIDER=mock                 # mock | openai-compatible
AGENTOS_MEDIA_PROVIDER=mock               # mock | higgsfield
AGENTOS_VIDEO_ASSEMBLY=ffmpeg-detect      # ffmpeg-detect | mock

# --- LLM drafting / structured extraction -----------------------------------
# Only read when AGENTOS_LLM_PROVIDER != mock. Leave blank for local dev.
AGENTOS_LLM_BASE_URL=
AGENTOS_LLM_API_KEY=
AGENTOS_LLM_MODEL=

# --- Higgsfield-compatible image / video generation -------------------------
# Only read when AGENTOS_MEDIA_PROVIDER=higgsfield.
HIGGSFIELD_BASE_URL=
HIGGSFIELD_API_KEY=

# --- ffmpeg (local video assembly) ------------------------------------------
# Path to the ffmpeg binary. If unset AgentOS looks it up on PATH; if not found
# the assembly step degrades to a mock manifest so the workflow still completes.
FFMPEG_PATH=

# --- Follow Up Boss ---------------------------------------------------------
# User-provided FUB API key. Stored locally only. AgentOS uses READ + draft/task
# write scope only: it never sends messages/emails or creates leads on its own.
# Leave blank to use the built-in mock FUB adapter.
FUB_API_KEY=
FUB_BASE_URL=https://api.followupboss.com/v1
# Shared secret used to verify inbound FUB webhook signatures. Real-time
# webhooks require a secure hosted relay (see docs/ARCHITECTURE.md) — the local
# receiver is for development and documentation only.
FUB_WEBHOOK_SECRET=

# --- Generation cost / rate limits ------------------------------------------
# Guardrails on the generation job queue. Cost is a preflight ESTIMATE in USD.
AGENTOS_MAX_JOBS_PER_HOUR=20
AGENTOS_MAX_JOB_COST_USD=25
AGENTOS_DAILY_SPEND_CAP_USD=100
